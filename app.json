{
  "expo": {
    "name": "PuerFlix",
    "slug": "puerflix",
    "version": "1.0.5",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "puerflix",
    "description": "Vídeos escolhidos pelos pais. Liberdade segura para os filhos.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.puerflix.app"
    },
    "android": {
      "package": "com.puerflix.app",
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
